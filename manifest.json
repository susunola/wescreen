{
  "manifest_version": 3,
  "name": "WeScreen",
  "version": "1.1.0",
  "default_locale": "zh_CN",
  "description": "__MSG_extDescription__",
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "downloads"],
  "commands": {
    "stop-recording": { "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" }, "description": "__MSG_commandStop__" },
    "pause-recording": { "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" }, "description": "__MSG_commandPause__" }
  }
}
